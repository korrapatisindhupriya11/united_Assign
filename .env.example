# Copy to .env if you want these defaults loaded automatically.
# Real environment variables win over .env.

# auto: use a local Transformers model when installed, otherwise quote excerpts.
# extractive | transformers | ollama | auto
LLM_BACKEND=auto
LLM_MODEL=google/flan-t5-small
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.08
GENERATION_TIMEOUT_SECONDS=90
